~ Test: the eight containers, and the verbs they share
~
~ The same words work on all of them. Which value comes out of pop()
~ is the only thing that changes.

~ ---------------------------------------------------------------
~ The shared verbs, on every container
~ ---------------------------------------------------------------
print "== the same verbs everywhere =="

to describe(name, box):
  box.add(1)
  box.add(2)
  box.add(3)
  print "{name}: length={box.length} has(2)={box.has(2)} peek={box.peek()} pop={box.pop()}"

describe("list ", [])
describe("set  ", set())
describe("stack", stack())
describe("queue", queue())
describe("deque", deque())
describe("heap ", heap())

~ ---------------------------------------------------------------
~ Tuples — a fixed row of values
~ ---------------------------------------------------------------
print "== tuples =="
point = (3, 4)
print point
print point[0]
print point[-1]
print point.length
print point.has(4)
print point.index_of(4)

single = (7,)
print single
print single.length

empty = ()
print empty.length

pair = (1, 2)
print pair == (1, 2)
print pair == (2, 1)
print pair < (1, 3)
print pair + (5, 6)
print point.to_list()

nested = ((1, 2), (3, 4))
print nested[1][0]

~ A tuple cannot change, and says so plainly
try:
  point.add(5)
catch err:
  print "immutable: caught"

~ ---------------------------------------------------------------
~ Sets — unique values, in the order they arrived
~ ---------------------------------------------------------------
print "== sets =="
s = {3, 1, 2, 3, 1}
print s
print s.length
print s.has(2)
print s.has(99)

s.add(10)
print s.length
s.add(10)
print s.length
print s.remove(10)
print s.remove(10)

a = {1, 2, 3}
b = {3, 4, 5}
print a.union(b)
print a.intersect(b)
print a.difference(b)
print a.symmetric_difference(b)
print a.is_subset({1, 2, 3, 4})
print a.is_superset({1, 2})
print a.is_disjoint({9})
print a + b
print a - b
print {1, 2} == {2, 1}

print set().length
print set([1, 1, 2]).length

~ Sets can hold tuples, because a tuple cannot change
coords = {(0, 0), (1, 1), (0, 0)}
print coords.length
print coords.has((1, 1))

total = 0
through a as item:
  total = total + item
print "sum through set: {total}"

~ ---------------------------------------------------------------
~ Queues — first one in is the first one out
~ ---------------------------------------------------------------
print "== queues =="
q = queue()
q.add("a")
q.add("b")
q.add("c")
print q
print q.pop()
print q.peek()
print q.length
print q.is_empty()

~ ---------------------------------------------------------------
~ Stacks — last one in is the first one out
~ ---------------------------------------------------------------
print "== stacks =="
st = stack([1, 2])
st.add(3)
print st
print st.pop()
print st.peek()
print st.length

~ Balanced brackets, the classic reason to reach for a stack
to balanced(text):
  pending = stack()
  through text as ch:
    if ch == "(":
      pending.add(ch)
    if ch == ")":
      if pending.is_empty():
        return false
      pending.pop()
  return pending.is_empty()

print balanced("(())")
print balanced("(()")

~ ---------------------------------------------------------------
~ Deques — a row you can use from either end
~ ---------------------------------------------------------------
print "== deques =="
d = deque([2, 3])
d.add_first(1)
d.add(4)
print d
print d.pop_first()
print d.pop()
print d
print d.length
d.add(9)
d.rotate(1)
print d
d.reverse()
print d
print d[0]
print d.peek_first()

~ ---------------------------------------------------------------
~ Heaps — the smallest value comes out first
~ ---------------------------------------------------------------
print "== heaps =="
h = heap([5, 1, 3])
h.add(0)
print h.peek()
print h.pop()
print h.pop()
print h.length
print h

mh = max_heap([5, 1, 3])
print mh.pop()

to heap_sort(items):
  h = heap(items)
  out = []
  while h.length > 0:
    out.add(h.pop())
  return out

print heap_sort([4, 2, 8, 1, 9])

~ ---------------------------------------------------------------
~ Every container turns into every other
~ ---------------------------------------------------------------
print "== conversions =="
base = [3, 1, 2, 1]
print base.to_set().length
print base.to_tuple()
print base.to_deque()
print base.to_stack()
print base.to_queue().to_list()
print {5, 6}.to_list()
tup = (1, 2)
print tup.to_set().length
print len({1, 2, 3})
print len(tup)
print type({1})
print type(tup)
print type(deque())
print type(queue())
print type(stack())
print type(heap())

~ ---------------------------------------------------------------
~ Wrong words get told the right one
~ ---------------------------------------------------------------
print "== the language teaches back =="

to says(box, doing):
  try:
    doing(box)
    return "no error"
  catch err:
    return err

print says(stack(), (b): b.push(1))
print says([], (b): b.contains(1))
print says({}, (b): b.items())
print says([], (b): b.lenght)
print says((1, 2), (b): b.add(3))
print says([], (b): b.pop())

print "Collection tests passed!"
